# Maintainer: Zqqdd
pkgname=archmates-bin
pkgver=0.2.4
pkgrel=1
pkgdesc="Peer-to-peer friends list for Arch Linux: see when your friends are online"
arch=('x86_64')
url="https://github.com/Zqqdd/Archmates"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('noctalia: Noctalia desktop widget'
            'gtk4-layer-shell: universal desktop widget (without Noctalia)'
            'python-gobject: universal desktop widget (without Noctalia)'
            'libnotify: notifications when a friend comes online'
            'python: automatic widget placement on Hyprland')
provides=('archmates')
conflicts=('archmates')
install=archmates.install
source=("$url/releases/download/v$pkgver/archmates-$pkgver-x86_64-linux.tar.gz")
sha256sums=('16b8b872599297297b34893bbf92741ea3c615a95acd57007a1f87cfbe5e7e02')

package() {
  cd "archmates-$pkgver-x86_64-linux"
  install -Dm755 archmates "$pkgdir/usr/bin/archmates"

  # Same service as the manual install, but pointing to the packaged binary.
  sed 's#^ExecStart=.*#ExecStart=/usr/bin/archmates daemon#' packaging/archmates.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/archmates.service"

  install -d "$pkgdir/usr/share/archmates"
  cp -r noctalia "$pkgdir/usr/share/archmates/"
  install -Dm755 scripts/setup-desktop.sh "$pkgdir/usr/share/archmates/setup-desktop.sh"
  install -Dm755 widget/archmates-widget "$pkgdir/usr/share/archmates/archmates-widget"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/share/archmates/setup-desktop.sh "$pkgdir/usr/bin/archmates-setup-desktop"
  ln -s /usr/share/archmates/archmates-widget "$pkgdir/usr/bin/archmates-widget"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
