[Unit]
Description=Archmates peer-to-peer presence (see when your friends are online)
# Starts with your user session, whatever desktop or compositor you use
# (graphical-session.target only exists with uwsm / some desktops).
After=network-online.target

[Service]
ExecStart=%h/.local/bin/archmates daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
