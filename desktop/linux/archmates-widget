def clear_opaque_region(window):
    """Tell the compositor the panel is see-through, so it blurs what is behind it."""
    import warnings
    surface = window.get_surface()
    if surface is not None and hasattr(surface, "set_opaque_region"):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", DeprecationWarning)
            surface.set_opaque_region(None)


CHAT_W, CHAT_H = 400, 560

# ── Voice messages ─────────────────────────────────────────────────────────────────────────
# The service records and plays them (its "voice desk") and describes what it does in
# voice-desk.json; the panel reads it ten times a second and asks through `archmates voice …`.
# Same recorder as Winmates and the Noctalia panel: record → listen → send.
DESK = STATE.parent / "voice-desk.json"


def load_desk():
    try:
        desk = json.loads(DESK.read_text())
    except (OSError, ValueError):
        return {"state": "idle"}
    return desk if time.time() * 1000 - desk.get("ms", 0) < 5000 else {"state": "idle"}


def progress_of(desk, msg_id):
    p = desk.get("playing")
    if p and p.get("id") == msg_id:
        return min(1.0, max(0.0, p["position"] / max(p["secs"], 0.1)))
    return None


def mmss(secs):
    secs = int(secs or 0)
    return f"{secs // 60}:{secs % 60:02d}"


class Waveform(Gtk.DrawingArea):
    """The same waveform as in Winmates and the Noctalia panel (bar heights come from the
    message time), filling up with the accent color while it plays."""

    def __init__(self, seed):
        super().__init__()
        self.seed = seed % 4294967296
        self.progress = 0.0
        self.set_content_width(130)
        self.set_content_height(24)
        self.set_valign(Gtk.Align.CENTER)
        self.set_draw_func(self.draw)

    def set_progress(self, progress):
        if progress != self.progress:
            self.progress = progress
            self.queue_draw()

    def draw(self, _area, cr, width, height):
        cr.set_line_width(2.5)
        for i in range(26):
            x = 1.25 + i * (width / 26)
            h = 5 + (((i * 2654435761 + self.seed) % 4294967296) >> 27) * 0.55
            done = i / 26 < self.progress
            cr.set_source_rgba(*(rgb(THEME["accent"]) if done else rgb(THEME["fg"], 0.35)))
            cr.move_to(x, height / 2 - h / 2)
            cr.line_to(x, height / 2 + h / 2)
            cr.stroke()


