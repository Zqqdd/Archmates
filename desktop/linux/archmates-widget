                               "message and file they sent you is deleted from this PC. This cannot be undone.",
                         xalign=0, wrap=True, max_width_chars=40)
        text.add_css_class("subtitle")
        box.append(text)
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.add_css_class("copy")
        cancel.connect("clicked", lambda _b: self.toggle_delete())
        delete = Gtk.Button(label="Delete")
        delete.add_css_class("copy")
        delete.add_css_class("danger")
        delete.connect("clicked", lambda _b: self.delete_conversation())
        buttons.append(cancel)
        buttons.append(delete)
        box.append(buttons)
        return box

    def delete_conversation(self):
        self.confirm_delete = False
        r = subprocess.run([ARCHMATES, "delete-chat", self.code, "--yes"], capture_output=True, text=True)
        self.status.set_text((r.stdout or r.stderr).strip().splitlines()[-1] if (r.stdout or r.stderr).strip() else "")
        self.last_count = -1
        self.refresh()

    def apply_blur(self):
        for pic in self.pictures:
            if self.is_active():
                pic.remove_css_class("blurred")
            else:
                pic.add_css_class("blurred")


def copy_to_clipboard(text):
    # wl-copy works even though the widget never takes keyboard focus.
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", text], check=False)
    else:
        Gdk.Display.get_default().get_clipboard().set(text)
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Archmates", "Your friend code was copied",
                          "Send it to your friend."])


class Widget(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.add_css_class("archmates")
        self.set_default_size(WIDTH, -1)
        self.set_resizable(False)

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "archmates-widget")
        LayerShell.set_layer(self, LayerShell.Layer.BACKGROUND)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.NONE)
        pos = load_position()
        monitor = pick_monitor(pos.get("output"))
        if monitor is not None:
            LayerShell.set_monitor(self, monitor)
        corner = str(pos.get("corner", "top-right"))
        vertical = LayerShell.Edge.BOTTOM if corner.startswith("bottom") else LayerShell.Edge.TOP
        horizontal = LayerShell.Edge.LEFT if corner.endswith("left") else LayerShell.Edge.RIGHT
        for edge, margin in ((vertical, pos.get("margin_y", 60)), (horizontal, pos.get("margin_x", 40))):
            LayerShell.set_anchor(self, edge, True)
            LayerShell.set_margin(self, edge, int(margin))

        self.card = GlassCard(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.card.add_css_class("card")
        self.monitor, self.vertical, self.horizontal = monitor, vertical, horizontal
        if not NATIVE_BLUR:
            self.card.add_css_class("self-frosted")
            self.card.frost = Frost()
            self.card.where = self.card_position
            # Placed from the screen edges (ignoring panels' reserved space), so the card knows
            # exactly which part of the wallpaper is under it.
            LayerShell.set_exclusive_zone(self, -1)
            # The wallpaper is blurred by the window's renderer, which exists once it is shown.
            self.connect("map", lambda _w: GLib.idle_add(self.frost_now))
        self.card.set_size_request(WIDTH, -1)
        self.set_child(self.card)
        self.position = pos
        make_draggable(self, self.card, vertical, horizontal, self.save_position)
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.signature = None
        self.refresh()
        GLib.timeout_add_seconds(REFRESH_SECONDS, self.refresh)

    def frost_now(self):
        self.card.frost.checked = 0
        if self.card.frost.refresh(self, self.monitor):
            self.card.queue_draw()
        return False

    def card_position(self):
        """Where the card is on its screen (for the self-frosted glass)."""
        geo = self.monitor.get_geometry() if self.monitor is not None else None
        if geo is None:
            return (0, 0)
        mx, my = LayerShell.get_margin(self, self.horizontal), LayerShell.get_margin(self, self.vertical)
        x = mx if self.horizontal == LayerShell.Edge.LEFT else geo.width - mx - self.get_width()
        y = my if self.vertical == LayerShell.Edge.TOP else geo.height - my - self.get_height()
        return (x, y)

    def save_position(self, margin_y, margin_x):
        """Remembers where you dragged the widget (in ~/.config/archmates/widget.toml)."""
        self.position.update(margin_x=margin_x, margin_y=margin_y)
        lines = [f'{k} = "{v}"' if isinstance(v, str) else f"{k} = {v}" for k, v in self.position.items()]
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        (CONFIG_DIR / "widget.toml").write_text("# Position of the archmates widget (drag it to move it)\n" + "\n".join(lines) + "\n")

    def apply_theme(self):
        signature = theme_signature()
        if signature == self.signature:
            return
        self.signature = signature
        c = theme_colors(self)
        self.css.load_from_string(theme_css(c))
        tint = Gdk.RGBA()
        tint.parse(c["bg"])
        tint.alpha = 0.35
        self.card.tint = tint

    def refresh(self):
        self.apply_theme()
        if self.card.frost is not None and self.card.frost.refresh(self, self.monitor):
            self.card.queue_draw()
        while (child := self.card.get_first_child()) is not None:
            self.card.remove(child)
        state = load_state()
        friends = (state or {}).get("friends", [])
        online = sum(1 for f in friends if f.get("status") == "online")

        header = Gtk.Box(spacing=8)
        users = Gtk.Image.new_from_icon_name(icon("users"))
        users.add_css_class("title")
        header.append(users)
        title = label("Archmates", "title")
        title.set_hexpand(True)
        header.append(title)
        header.append(label(f"{online}/{len(friends)} online", "count", xalign=1.0))
        self.card.append(header)

        if state is None:
            self.card.append(label("Service stopped.\nRun: systemctl --user start archmates", "warning"))
            return True
        me = state.get("me", {})
        if time.time() * 1000 - me.get("updated_ms", 0) > 120_000:
            self.card.append(label("Service stopped (status frozen)", "warning"))
        if me.get("update_available"):
            self.card.append(label(f"Update {me['update_available']}: archmates update --install", "notice"))
        if me.get("invisible"):
            self.card.append(label("You are in invisible mode", "notice"))

        if not friends:
            self.card.append(label("No friends yet.\narchmates add <code> <nickname>", "subtitle"))
        else:
            self.card.append(Gtk.Separator())
            for f in sorted(friends, key=lambda f: (ORDER.get(f.get("status"), 3), f.get("nickname", "").lower())):
                self.card.append(friend_row(f))

        button = Gtk.Button(halign=Gtk.Align.END)
        content = Gtk.Box(spacing=6)
        content.append(Gtk.Image.new_from_icon_name(icon("copy")))
        content.append(Gtk.Label(label="Copy my code"))
        button.set_child(content)
        button.add_css_class("quiet")
        button.connect("clicked", lambda _b: copy_to_clipboard(me.get("code", "")))
        self.card.append(button)
        return True


APP = None
OPEN_WINDOWS = {}


def open_friend(code):
    win = OPEN_WINDOWS.get(code)
    if win is None or not win.get_visible():
        win = FriendWindow(APP, code)
        OPEN_WINDOWS[code] = win
    win.present()


def on_activate(app):
    global APP, NATIVE_BLUR
    APP = app
    NATIVE_BLUR = "--no-native-blur" not in sys.argv and request_native_blur()
    display = Gdk.Display.get_default()
    setup_icons()
    user_css = CONFIG_DIR / "widget.css"
    if user_css.exists():
        custom = Gtk.CssProvider()
        custom.load_from_path(str(user_css))
        Gtk.StyleContext.add_provider_for_display(display, custom, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    if "--chat-only" in sys.argv:
        # Only the chat panel (opened from the Noctalia widget); quit when it closes.
        i = sys.argv.index("--friend") if "--friend" in sys.argv else -1
        if i < 0 or i + 1 >= len(sys.argv):
            app.quit()
            return
        css = Gtk.CssProvider()
        probe = Gtk.Window()
        css.load_from_string(theme_css(theme_colors(probe)))
        Gtk.StyleContext.add_provider_for_display(display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = FriendWindow(app, sys.argv[i + 1])
        win.connect("close-request", lambda _w: (app.quit(), False)[-1])
        win.present()
        return
    Widget(app).present()
    if "--friend" in sys.argv:  # open a friend's window right away (handy from a keybind)
        i = sys.argv.index("--friend")
        if i + 1 < len(sys.argv):
            open_friend(sys.argv[i + 1])


def pick_file():
    """`archmates-widget --pick-file`: shows a file chooser and prints the chosen path."""
    from gi.repository import Gio
    app = Gtk.Application(application_id="io.github.zqqdd.archmates.picker",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(a):
        win = Gtk.Window(application=a)
        dialog = Gtk.FileDialog(title="Send a file")

        def done(dlg, result):
            try:
                file = dlg.open_finish(result)
                if file and file.get_path():
                    print(file.get_path(), flush=True)
            except GLib.Error:
                pass
            a.quit()

        dialog.open(win, None, done)

    app.connect("activate", activate)
    app.run([])


def main():
    if "--pick-file" in sys.argv:
        pick_file()
        return
    if not LayerShell.is_supported():
        sys.exit("archmates-widget: this desktop does not support the layer-shell protocol (GNOME?).")
    # NON_UNIQUE: a new widget must start even while an old one (e.g. before an update) is exiting.
    from gi.repository import Gio
    app = Gtk.Application(application_id="io.github.zqqdd.archmates.widget",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)
    app.connect("activate", on_activate)
    app.run([])


if __name__ == "__main__":
    main()
