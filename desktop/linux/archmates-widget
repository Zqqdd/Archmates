def theme_colors(widget):
    """bg / fg / accent from, in order: pywal (~/.cache/wal/colors.json, also written by wallust),
    the GTK theme (incl. libadwaita and matugen-generated colors), then built-in defaults."""
    colors = dict(FALLBACK)
    try:
        wal = json.loads(WAL_COLORS.read_text())
        colors.update(bg=wal["special"]["background"], fg=wal["special"]["foreground"],
                      accent=wal["colors"].get("color4") or wal["colors"]["color1"])
        return colors
    except (OSError, ValueError, KeyError, TypeError):
        pass
    import warnings
    names = {
        "bg": ("window_bg_color", "theme_bg_color"),
        "fg": ("window_fg_color", "theme_fg_color"),
        "accent": ("accent_bg_color", "accent_color", "theme_selected_bg_color"),
    }
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", DeprecationWarning)
        ctx = widget.get_style_context()
        for key, candidates in names.items():
            for name in candidates:
                found, rgba = ctx.lookup_color(name)
                if found:
                    colors[key] = "#{:02x}{:02x}{:02x}".format(
                        round(rgba.red * 255), round(rgba.green * 255), round(rgba.blue * 255))
                    break
    return colors


def theme_signature():
    """Changes whenever the theme may have changed, to recolor the widget live."""
    settings = Gtk.Settings.get_default()
    try:
        wal = WAL_COLORS.stat().st_mtime
    except OSError:
        wal = None
    return (settings.props.gtk_theme_name, settings.props.gtk_application_prefer_dark_theme, wal)


