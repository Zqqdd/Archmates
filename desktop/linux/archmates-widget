LAST_DRAG = 0.0


def make_draggable(window, handle, vertical, horizontal, on_end=None):
    """Move a layer-shell window by dragging `handle`, keeping the grabbed point under the mouse.

    Offsets are measured in the window's own coordinates, which shift as the window moves; so the
    window is moved at most once per frame, and pointer events from before that move are ignored.
    Without this, the window lags and bounces behind the mouse."""
    drag = Gtk.GestureDrag()
    state = {"active": False, "offset": None, "waiting": False, "moved": 0}

    def sign(edge, d):
        return d if edge in (LayerShell.Edge.LEFT, LayerShell.Edge.TOP) else -d

    def tick(_widget, _clock):
        if not state["active"]:
            return GLib.SOURCE_REMOVE
        if state["waiting"]:
            state["waiting"] = False          # the previous move is now on screen
        elif state["offset"] is not None:
            dx, dy = state["offset"]
            state["offset"] = None
            h = LayerShell.get_margin(window, horizontal) + sign(horizontal, dx)
            v = LayerShell.get_margin(window, vertical) + sign(vertical, dy)
            LayerShell.set_margin(window, horizontal, max(0, int(round(h))))
            LayerShell.set_margin(window, vertical, max(0, int(round(v))))
            state["moved"] += abs(dx) + abs(dy)
            state["waiting"] = True
        return GLib.SOURCE_CONTINUE

    def begin(_g, _x, _y):
        state.update(active=True, offset=None, waiting=False, moved=0)
        handle.add_tick_callback(tick)

    def update(_g, dx, dy):
        if not state["waiting"]:
            state["offset"] = (dx, dy)

    def end(_g, _dx, _dy):
        global LAST_DRAG
        state["active"] = False
        if state["moved"] > 6:
            LAST_DRAG = time.time()  # so the click that ends a drag does not open a chat
        if on_end:
            on_end(LayerShell.get_margin(window, vertical), LayerShell.get_margin(window, horizontal))

    drag.connect("drag-begin", begin)
    drag.connect("drag-update", update)
    drag.connect("drag-end", end)
    handle.add_controller(drag)
    handle.set_cursor_from_name("grab")


IMAGE_EXT = (".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp")


def image_preview(path, width=240, height=170):
    """A scaled picture for the chat (None if the file is not a readable image)."""
    if not path or not path.lower().endswith(IMAGE_EXT) or not os.path.exists(path):
        return None
    try:
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, width, height, True)
    except (GLib.Error, ValueError, ImportError):
        return None
    import warnings
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", DeprecationWarning)
        texture = Gdk.Texture.new_for_pixbuf(pix)
    pic = Gtk.Picture.new_for_paintable(texture)
    pic.set_size_request(pix.get_width(), pix.get_height())
    pic.set_can_shrink(False)
    pic.add_css_class("chat-image")
    return pic


ARCHMATES = shutil.which("archmates") or str(HOME / ".local" / "bin" / "archmates")


def gb(n):
    return f"{(n or 0) / 1073741824:.1f}"


def stat_bar(name, used, total):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
    top = Gtk.Box(spacing=6)
    top.append(label(name, "stat-name"))
    value = label(f"{gb(used)} / {gb(total)} GB", "stat-value")
    value.set_hexpand(True)
    top.append(value)
    pct = used / total if total else 0
    top.append(label(f"{round(pct * 100)}%", "stat-pct", xalign=1.0))
    box.append(top)
    level = Gtk.LevelBar(min_value=0, max_value=1, value=min(pct, 1))
    box.append(level)
    return box


def clear_opaque_region(window):
    """Tell the compositor the panel is see-through, so it blurs what is behind it."""
    import warnings
    surface = window.get_surface()
    if surface is not None and hasattr(surface, "set_opaque_region"):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", DeprecationWarning)
            surface.set_opaque_region(None)


CHAT_W, CHAT_H = 400, 560


class FriendWindow(Gtk.Window):
    """Opens when you click a friend: profile, RAM / storage, conversation, messages and files.
    A floating panel above your windows (like Noctalia's), moved by dragging its header."""

    def __init__(self, app, code):
        super().__init__(application=app, title="Archmates")
        self.code = code
        self.add_css_class("archmates-chat")
        self.set_resizable(False)
        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "archmates-chat")
        self.connect("realize", lambda w: clear_opaque_region(w))
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)
        monitor = pick_monitor(load_position().get("output"))
        if monitor is not None:
            LayerShell.set_monitor(self, monitor)
        geo = monitor.get_geometry() if monitor is not None else None
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self, LayerShell.Edge.LEFT, True)
        LayerShell.set_margin(self, LayerShell.Edge.LEFT, max(0, (geo.width - CHAT_W) // 2) if geo else 200)
        LayerShell.set_margin(self, LayerShell.Edge.TOP, max(0, (geo.height - CHAT_H) // 2) if geo else 150)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, keyval, _code, _state: keyval == Gdk.KEY_Escape and (self.close() or True))
        self.add_controller(keys)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.add_css_class("card")
        root.add_css_class("chat-card")
        root.set_size_request(CHAT_W, CHAT_H)
        self.set_default_size(CHAT_W, CHAT_H)
        self.set_child(root)

        self.header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        root.append(self.header)
        make_draggable(self, self.header, LayerShell.Edge.TOP, LayerShell.Edge.LEFT)
        root.append(Gtk.Separator())
        self.messages = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        # The conversation scrolls inside a fixed-size panel instead of growing the window.
        self.scroller.set_propagate_natural_height(False)
        self.scroller.set_propagate_natural_width(False)
        self.scroller.set_size_request(-1, 200)
        self.scroller.set_child(self.messages)
        root.append(self.scroller)

        bottom = Gtk.Box(spacing=6)
        attach = Gtk.Button(icon_name="mail-attachment-symbolic", tooltip_text="Send a file")
        attach.add_css_class("ghost")
        attach.connect("clicked", lambda _b: self.pick_file())
        bottom.append(attach)
        self.entry = Gtk.Entry(hexpand=True, placeholder_text="Message…")
        self.entry.add_css_class("chat-entry")
        self.entry.connect("activate", lambda _e: self.send_message())
        bottom.append(self.entry)
        send = Gtk.Button(icon_name="mail-send-symbolic")
        send.add_css_class("send")
        send.connect("clicked", lambda _b: self.send_message())
        bottom.append(send)
        root.append(bottom)
        self.status = label("", "subtitle")
        root.append(self.status)

        self.pictures = []
        self.confirm_delete = False
        # Pictures are blurred whenever you are not on this panel (another window is active).
        self.connect("notify::is-active", lambda *_: self.apply_blur())
        self.last_count = -1
        self.fetching = False
        self.refresh()
        GLib.timeout_add_seconds(3, self.refresh)

    def friend(self):
        for f in (load_state() or {}).get("friends", []):
            if f.get("code") == self.code:
                return f
        return None

    def run(self, args):
        self.status.set_text("…")

        def worker():
            r = subprocess.run([ARCHMATES, *args], capture_output=True, text=True)
            out = (r.stdout if r.returncode == 0 else (r.stderr or r.stdout)).strip()
            text = out.removeprefix("✓ ") if r.returncode == 0 else "Error: " + out.removeprefix("Error: ")
            GLib.idle_add(lambda: (self.status.set_text(text.splitlines()[-1] if text else ""), self.refresh(), False)[-1])

        import threading
        threading.Thread(target=worker, daemon=True).start()

    def send_message(self):
        text = self.entry.get_text().strip()
        if text:
            self.entry.set_text("")
            self.run(["send", self.code, text])

    def pick_file(self):
        # The chooser runs in its own process: a file dialog attached to a layer-shell panel can
        # crash GTK, and must never take the widget down with it.
        import threading

        def worker():
            r = subprocess.run([sys.executable, os.path.abspath(__file__), "--pick-file"],
                               capture_output=True, text=True)
            path = r.stdout.strip()
            if path:
                GLib.idle_add(lambda: (self.status.set_text(
                    f"Waiting for your friend to accept {os.path.basename(path)}…"),
                    self.run(["send-file", self.code, path]), False)[-1])

        threading.Thread(target=worker, daemon=True).start()

    def offer_card(self, f, o):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.add_css_class("offer")
        card.append(label(f"{f.get('nickname')} wants to send you {o['name']} ({o['size'] / 1048576:.1f} MB)", "nickname"))
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        no = Gtk.Button(label="Decline")
        no.add_css_class("copy")
        no.connect("clicked", lambda _b: self.run(["decline", o["id"]]))
        yes = Gtk.Button(label="Accept")
        yes.add_css_class("copy")
        yes.add_css_class("accept")
        yes.connect("clicked", lambda _b: self.run(["accept", o["id"]]))
        buttons.append(no)
        buttons.append(yes)
        card.append(buttons)
        return card

    def refresh(self):
        f = self.friend()
        while (child := self.header.get_first_child()) is not None:
            self.header.remove(child)
        if f is None:
            self.header.append(label("Friend not found.", "warning"))
            return True
        p = f.get("profile") or {}
        self.set_title(f"Archmates — {f.get('nickname')}")
        top = Gtk.Box(spacing=12)
        top.append(avatar(f, 52))
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True, valign=Gtk.Align.CENTER)
        col.append(label(f.get("nickname", "?"), "chat-name"))
        if p:
            col.append(label(f"{p['user']}@{p['host']} · {p['distro']}", "subtitle"))
        status = f.get("status")
        line = Gtk.Box(spacing=6)
        dot = Gtk.Box(valign=Gtk.Align.CENTER)
        dot.add_css_class("dot")
        dot.add_css_class("online" if status == "online" else "offline")
        line.append(dot)
        line.append(label("online" if status == "online" else "hasn't added you yet" if status == "pending"
                          else f"last seen {ago(f['last_seen_ms'])}" if f.get("last_seen_ms") else "offline", "subtitle"))
        col.append(line)
        top.append(col)
        gear = Gtk.Button(icon_name="emblem-system-symbolic", valign=Gtk.Align.START, tooltip_text="Delete conversation")
        gear.add_css_class("ghost")
        gear.connect("clicked", lambda _b: self.toggle_delete())
        top.append(gear)
        close = Gtk.Button(icon_name="window-close-symbolic", valign=Gtk.Align.START)
        close.add_css_class("ghost")
        close.connect("clicked", lambda _b: self.close())
        top.append(close)
        self.header.append(top)
        if self.confirm_delete:
            self.header.append(self.delete_box(f))
        for o in f.get("offers", []):
            self.header.append(self.offer_card(f, o))
        stats = p.get("stats")
        if stats:
            bars = Gtk.Box(spacing=14)
            bars.append(stat_bar("RAM", stats["ram_used"], stats["ram_total"]))
            bars.append(stat_bar("Disk", stats["disk_used"], stats["disk_total"]))
            self.header.append(bars)
        else:
            self.header.append(label("RAM and storage not shared", "subtitle"))

        # Reading the conversation runs a command: in a thread, so the window never freezes.
        if not self.fetching:
            self.fetching = True
            threading.Thread(target=self.fetch_messages, daemon=True).start()
        return True

    def fetch_messages(self):
        r = subprocess.run([ARCHMATES, "chat", self.code, "--json", "-n", "40"], capture_output=True, text=True)
        try:
            messages = json.loads(r.stdout) if r.returncode == 0 else []
        except ValueError:
            messages = []
        GLib.idle_add(self.show_messages, messages)

    def show_messages(self, messages):
        self.fetching = False
        if len(messages) != self.last_count or any(not m.get("delivered") for m in messages):
            # Only messages that just arrived get the fade-in.
            first_new = self.last_count if self.last_count >= 0 else len(messages)
            self.last_count = len(messages)
            while (child := self.messages.get_first_child()) is not None:
                self.messages.remove(child)
            self.pictures = []
            if not messages:
                self.messages.append(label("No messages yet. Say hi!", "empty"))
            for index, m in enumerate(messages):
                mine = m.get("dir") == "out"
                b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                            halign=Gtk.Align.END if mine else Gtk.Align.START)
                b.add_css_class("bubble")
                b.add_css_class("mine" if mine else "theirs")
                if index >= first_new:
                    b.add_css_class("new")
                text = m.get("text", "") + ("  ⏳" if mine and not m.get("delivered") else "")
                picture = None if m.get("voice") else image_preview(m.get("file"))
                if m.get("voice"):
                    b.append(self.voice_widget(m))
                elif picture is not None:
                    self.pictures.append(picture)
                    b.append(picture)
                else:
                    msg = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=32, selectable=True)
                    msg.add_css_class("bubble-text")
                    msg.set_wrap_mode(2)  # Pango.WrapMode.WORD_CHAR: long words wrap too
                    b.append(msg)
                b.append(label(ago(m.get("ms", 0)), "time"))
                self.messages.append(b)
            self.apply_blur()
            GLib.idle_add(lambda: self.scroller.get_vadjustment().set_value(1e9) or False)
        return False

    def voice_widget(self, m):
        """Voice messages: a play button while the recording exists (until the next restart)."""
        secs = m.get("voice") or 0
        length = f"{secs // 60}:{secs % 60:02d}"
        path = m.get("file")
        if not path or not os.path.exists(path):
            return label(f"🎤 Voice message · {length} · expired", "subtitle")
        button = Gtk.Button(label=f"▶  Voice message · {length}")
        button.add_css_class("voice")
        button.connect("clicked", lambda _b: subprocess.Popen([ARCHMATES, "voice", "play", path]))
        return button

    def toggle_delete(self):
        self.confirm_delete = not self.confirm_delete
        self.refresh()

    def delete_box(self, f):
        """⚙ → delete the whole conversation, with every file this friend sent you."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.add_css_class("danger-box")
        text = Gtk.Label(label=f"Delete your conversation with {f.get('nickname')} for good? Every message, voice "
                               "message and file they sent you is deleted from this PC. This cannot be undone.",
                         xalign=0, wrap=True, max_width_chars=40)
        text.add_css_class("subtitle")
        box.append(text)
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.add_css_class("copy")
        cancel.connect("clicked", lambda _b: self.toggle_delete())
        delete = Gtk.Button(label="Delete")
        delete.add_css_class("copy")
        delete.add_css_class("danger")
        delete.connect("clicked", lambda _b: self.delete_conversation())
        buttons.append(cancel)
        buttons.append(delete)
        box.append(buttons)
        return box

    def delete_conversation(self):
        self.confirm_delete = False
        r = subprocess.run([ARCHMATES, "delete-chat", self.code, "--yes"], capture_output=True, text=True)
        self.status.set_text((r.stdout or r.stderr).strip().splitlines()[-1] if (r.stdout or r.stderr).strip() else "")
        self.last_count = -1
        self.refresh()

    def apply_blur(self):
        for pic in self.pictures:
            if self.is_active():
                pic.remove_css_class("blurred")
            else:
                pic.add_css_class("blurred")


def copy_to_clipboard(text):
    # wl-copy works even though the widget never takes keyboard focus.
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", text], check=False)
    else:
        Gdk.Display.get_default().get_clipboard().set(text)
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Archmates", "Your friend code was copied",
                          "Send it to your friend."])


class Widget(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.add_css_class("archmates")
        self.set_default_size(WIDTH, -1)
        self.set_resizable(False)

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "archmates-widget")
        LayerShell.set_layer(self, LayerShell.Layer.BACKGROUND)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.NONE)
        pos = load_position()
        monitor = pick_monitor(pos.get("output"))
        if monitor is not None:
            LayerShell.set_monitor(self, monitor)
        corner = str(pos.get("corner", "top-right"))
        vertical = LayerShell.Edge.BOTTOM if corner.startswith("bottom") else LayerShell.Edge.TOP
        horizontal = LayerShell.Edge.LEFT if corner.endswith("left") else LayerShell.Edge.RIGHT
        for edge, margin in ((vertical, pos.get("margin_y", 60)), (horizontal, pos.get("margin_x", 40))):
            LayerShell.set_anchor(self, edge, True)
            LayerShell.set_margin(self, edge, int(margin))

        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.card.add_css_class("card")
        self.card.set_size_request(WIDTH, -1)
        self.set_child(self.card)
        self.position = pos
        make_draggable(self, self.card, vertical, horizontal, self.save_position)
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.signature = None
        self.refresh()
        GLib.timeout_add_seconds(REFRESH_SECONDS, self.refresh)

    def save_position(self, margin_y, margin_x):
        """Remembers where you dragged the widget (in ~/.config/archmates/widget.toml)."""
        self.position.update(margin_x=margin_x, margin_y=margin_y)
        lines = [f'{k} = "{v}"' if isinstance(v, str) else f"{k} = {v}" for k, v in self.position.items()]
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        (CONFIG_DIR / "widget.toml").write_text("# Position of the archmates widget (drag it to move it)\n" + "\n".join(lines) + "\n")

    def apply_theme(self):
        signature = theme_signature()
        if signature == self.signature:
            return
        self.signature = signature
        c = theme_colors(self)
        self.css.load_from_string(
            f"@define-color bg {c['bg']};\n@define-color fg {c['fg']};\n@define-color accent {c['accent']};\n"
            + DEFAULT_CSS)

    def refresh(self):
        self.apply_theme()
        while (child := self.card.get_first_child()) is not None:
            self.card.remove(child)
        state = load_state()
        friends = (state or {}).get("friends", [])
        online = sum(1 for f in friends if f.get("status") == "online")

        header = Gtk.Box(spacing=8)
        icon = Gtk.Image.new_from_icon_name("system-users-symbolic")
        icon.add_css_class("title")
        header.append(icon)
        title = label("Archmates", "title")
        title.set_hexpand(True)
        header.append(title)
        header.append(label(f"{online}/{len(friends)} online", "count", xalign=1.0))
        self.card.append(header)

        if state is None:
            self.card.append(label("Service stopped.\nRun: systemctl --user start archmates", "warning"))
            return True
        me = state.get("me", {})
        if time.time() * 1000 - me.get("updated_ms", 0) > 120_000:
            self.card.append(label("Service stopped (status frozen)", "warning"))
        if me.get("update_available"):
            self.card.append(label(f"Update {me['update_available']}: archmates update --install", "notice"))
        if me.get("invisible"):
            self.card.append(label("You are in invisible mode", "notice"))

        if not friends:
            self.card.append(label("No friends yet.\narchmates add <code> <nickname>", "subtitle"))
        else:
            self.card.append(Gtk.Separator())
            for f in sorted(friends, key=lambda f: (ORDER.get(f.get("status"), 3), f.get("nickname", "").lower())):
                self.card.append(friend_row(f))

        button = Gtk.Button(label="Copy my code", halign=Gtk.Align.END)
        button.add_css_class("copy")
        button.connect("clicked", lambda _b: copy_to_clipboard(me.get("code", "")))
        self.card.append(button)
        return True


APP = None
OPEN_WINDOWS = {}


def open_friend(code):
    win = OPEN_WINDOWS.get(code)
    if win is None or not win.get_visible():
        win = FriendWindow(APP, code)
        OPEN_WINDOWS[code] = win
    win.present()


def on_activate(app):
    global APP
    APP = app
    display = Gdk.Display.get_default()
    user_css = CONFIG_DIR / "widget.css"
    if user_css.exists():
        custom = Gtk.CssProvider()
        custom.load_from_path(str(user_css))
        Gtk.StyleContext.add_provider_for_display(display, custom, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    if "--chat-only" in sys.argv:
        # Only the chat panel (opened from the Noctalia widget); quit when it closes.
        i = sys.argv.index("--friend") if "--friend" in sys.argv else -1
        if i < 0 or i + 1 >= len(sys.argv):
            app.quit()
            return
        css = Gtk.CssProvider()
        probe = Gtk.Window()
        c = theme_colors(probe)
        css.load_from_string(f"@define-color bg {c['bg']};\n@define-color fg {c['fg']};\n@define-color accent {c['accent']};\n" + DEFAULT_CSS)
        Gtk.StyleContext.add_provider_for_display(display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = FriendWindow(app, sys.argv[i + 1])
        win.connect("close-request", lambda _w: (app.quit(), False)[-1])
        win.present()
        return
    Widget(app).present()
    if "--friend" in sys.argv:  # open a friend's window right away (handy from a keybind)
        i = sys.argv.index("--friend")
        if i + 1 < len(sys.argv):
            open_friend(sys.argv[i + 1])


def pick_file():
    """`archmates-widget --pick-file`: shows a file chooser and prints the chosen path."""
    from gi.repository import Gio
    app = Gtk.Application(application_id="io.github.zqqdd.archmates.picker",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(a):
        win = Gtk.Window(application=a)
        dialog = Gtk.FileDialog(title="Send a file")

        def done(dlg, result):
            try:
                file = dlg.open_finish(result)
                if file and file.get_path():
                    print(file.get_path(), flush=True)
            except GLib.Error:
                pass
            a.quit()

        dialog.open(win, None, done)

    app.connect("activate", activate)
    app.run([])


def main():
    if "--pick-file" in sys.argv:
        pick_file()
        return
    if not LayerShell.is_supported():
        sys.exit("archmates-widget: this desktop does not support the layer-shell protocol (GNOME?).")
    # NON_UNIQUE: a new widget must start even while an old one (e.g. before an update) is exiting.
    from gi.repository import Gio
    app = Gtk.Application(application_id="io.github.zqqdd.archmates.widget",
                          flags=Gio.ApplicationFlags.NON_UNIQUE)
    app.connect("activate", on_activate)
    app.run([])


if __name__ == "__main__":
    main()
