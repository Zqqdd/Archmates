        self.entry.add_css_class("chat-entry")
        self.entry.connect("activate", lambda _e: self.send_message())
        bottom.append(self.entry)
        send = Gtk.Button(icon_name=icon("send"), tooltip_text="Send")
        send.add_css_class("send")
        send.connect("clicked", lambda _b: self.send_message())
        bottom.append(send)
        # The message field, or the recorder while recording / listening for this friend.
        self.composer = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=150)
        self.composer.add_named(bottom, "compose")
        self.recorder = Gtk.Box(spacing=6)
        self.composer.add_named(self.recorder, "voice")
        root.append(self.composer)
        self.desk = {"state": "idle"}
        self.desk_key = None
        self.waves = {}     # message id → (Waveform, play button holder)
        self.status = label("", "subtitle")
        root.append(self.status)

        self.pictures = []
        self.confirm_delete = False
        # Pictures are blurred whenever you are not on this panel (another window is active).
        self.connect("notify::is-active", lambda *_: self.apply_blur())
        self.last_count = -1
        self.fetching = False
        self.refresh()
        GLib.timeout_add_seconds(3, self.refresh)
        self.closed = False
        self.connect("close-request", lambda _w: setattr(self, "closed", True) or False)
        GLib.timeout_add(100, self.tick_desk)

    # ── Voice ──

    def voice(self, args, quiet=False):
        if not quiet:
            self.status.set_text("…")

        def worker():
            r = subprocess.run([ARCHMATES, "voice", *args], capture_output=True, text=True)
            out = (r.stdout if r.returncode == 0 else (r.stderr or r.stdout)).strip()
            text = out.lstrip("✓■●▶ ") if r.returncode == 0 else "Error: " + out.removeprefix("Error: ")
            show = (not quiet or r.returncode != 0) and text
            GLib.idle_add(lambda: (show and self.status.set_text(text.splitlines()[-1]), self.tick_desk(),
                                   self.refresh(), False)[-1])

        threading.Thread(target=worker, daemon=True).start()

    def tick_desk(self):
        if self.closed:
            return False
        self.desk = load_desk()
        mine = self.desk.get("state") != "idle" and self.desk.get("to") == self.code
        playing = self.desk.get("playing") or {}
        key = (mine and self.desk.get("state"), playing.get("id"), self.desk.get("error"))
        if key != self.desk_key:
            self.desk_key = key
            self.build_recorder(mine)
            for msg_id, (wave, holder) in self.waves.items():
                self.set_play_button(holder, msg_id, wave)
        for msg_id, (wave, _holder) in self.waves.items():
            wave.set_progress(progress_of(self.desk, msg_id) or 0.0)
        if mine and self.desk.get("state") == "recording":
            self.rec_time.set_text(f"{mmss(self.desk.get('secs'))} / 5:00")
            self.rec_level.set_value(min(1.0, (self.desk.get("level") or 0) * 1.6))
        elif mine:
            self.draft_wave.set_progress(progress_of(self.desk, "draft") or 0.0)
        return True

    def build_recorder(self, mine):
        while (child := self.recorder.get_first_child()) is not None:
            self.recorder.remove(child)
        self.composer.set_visible_child_name("voice" if mine else "compose")
        if not mine:
            return
        send = Gtk.Button(icon_name=icon("send"), tooltip_text="Send the voice message")
        send.add_css_class("send")
        send.connect("clicked", lambda _b: self.desk.get("state") != "sending" and (
            self.status.set_text("Sending the voice message…"), self.voice(["send-recording"]))[-1])
        if self.desk.get("state") == "recording":
            self.recorder.append(ghost_button(icon("x"), "Cancel", lambda: self.voice(["discard"], True)))
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.add_css_class("rec-dot")
            self.recorder.append(dot)
            self.rec_time = label("0:00 / 5:00", "rec-time")
            self.recorder.append(self.rec_time)
            self.rec_level = Gtk.LevelBar(min_value=0, max_value=1, hexpand=True, valign=Gtk.Align.CENTER)
            self.recorder.append(self.rec_level)
            self.recorder.append(ghost_button(icon("player-stop-filled"), "Stop and listen",
                                              lambda: self.voice(["stop"], True)))
        else:
            self.recorder.append(ghost_button(icon("trash"), "Discard",
                                              lambda: self.desk.get("state") != "sending" and self.voice(["discard"], True)))
            playing = progress_of(self.desk, "draft") is not None
            self.recorder.append(play_button(playing, lambda: self.voice(
                ["stop-playing"] if playing else ["play", "--no-wait"], True)))
            self.draft_wave = Waveform(0)
            self.recorder.append(self.draft_wave)
            length = label(mmss(self.desk.get("secs")), "voice-time")
            length.set_hexpand(True)
            self.recorder.append(length)
            if self.desk.get("error"):
                self.status.set_text("Error: " + self.desk["error"])
        self.recorder.append(send)

    def set_play_button(self, holder, msg_id, wave):
        while (child := holder.get_first_child()) is not None:
            holder.remove(child)
        playing = progress_of(self.desk, msg_id) is not None
        path = wave.path
        holder.append(play_button(playing, lambda: self.voice(
            ["stop-playing"] if playing else ["play", path, "--id", msg_id, "--no-wait"], True)))

    def friend(self):
        for f in (load_state() or {}).get("friends", []):
            if f.get("code") == self.code:
                return f
        return None

    def run(self, args):
        self.status.set_text("…")

        def worker():
            r = subprocess.run([ARCHMATES, *args], capture_output=True, text=True)
            out = (r.stdout if r.returncode == 0 else (r.stderr or r.stdout)).strip()
            text = out.removeprefix("✓ ") if r.returncode == 0 else "Error: " + out.removeprefix("Error: ")
            GLib.idle_add(lambda: (self.status.set_text(text.splitlines()[-1] if text else ""), self.refresh(), False)[-1])

        import threading
        threading.Thread(target=worker, daemon=True).start()

    def send_message(self):
        text = self.entry.get_text().strip()
        if text:
            self.entry.set_text("")
            self.run(["send", self.code, text])

    def pick_file(self):
        # The chooser runs in its own process: a file dialog attached to a layer-shell panel can
        # crash GTK, and must never take the widget down with it.
        import threading

        def worker():
            r = subprocess.run([sys.executable, os.path.abspath(__file__), "--pick-file"],
                               capture_output=True, text=True)
            path = r.stdout.strip()
            if path:
                GLib.idle_add(lambda: (self.status.set_text(
                    f"Waiting for your friend to accept {os.path.basename(path)}…"),
                    self.run(["send-file", self.code, path]), False)[-1])

        threading.Thread(target=worker, daemon=True).start()

