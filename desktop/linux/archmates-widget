LAST_DRAG = 0.0


def make_draggable(window, handle, vertical, horizontal, on_end=None):
    """Move a layer-shell window by dragging `handle`, keeping the grabbed point under the mouse.

    Offsets are measured in the window's own coordinates, which shift as the window moves; so the
    window is moved at most once per frame, and pointer events from before that move are ignored.
    Without this, the window lags and bounces behind the mouse."""
    drag = Gtk.GestureDrag()
    state = {"active": False, "offset": None, "waiting": False, "moved": 0}

    def sign(edge, d):
        return d if edge in (LayerShell.Edge.LEFT, LayerShell.Edge.TOP) else -d

    def tick(_widget, _clock):
        if not state["active"]:
            return GLib.SOURCE_REMOVE
        if state["waiting"]:
            state["waiting"] = False          # the previous move is now on screen
        elif state["offset"] is not None:
            dx, dy = state["offset"]
            state["offset"] = None
            h = LayerShell.get_margin(window, horizontal) + sign(horizontal, dx)
            v = LayerShell.get_margin(window, vertical) + sign(vertical, dy)
            LayerShell.set_margin(window, horizontal, max(0, int(round(h))))
            LayerShell.set_margin(window, vertical, max(0, int(round(v))))
            handle.queue_draw()  # a self-frosted card shows another part of the wallpaper
            state["moved"] += abs(dx) + abs(dy)
            state["waiting"] = True
        return GLib.SOURCE_CONTINUE

    def begin(_g, _x, _y):
        state.update(active=True, offset=None, waiting=False, moved=0)
        handle.add_tick_callback(tick)

    def update(_g, dx, dy):
        if not state["waiting"]:
            state["offset"] = (dx, dy)

    def end(_g, _dx, _dy):
        global LAST_DRAG
        state["active"] = False
        if state["moved"] > 6:
            LAST_DRAG = time.time()  # so the click that ends a drag does not open a chat
        if on_end:
            on_end(LayerShell.get_margin(window, vertical), LayerShell.get_margin(window, horizontal))

    drag.connect("drag-begin", begin)
    drag.connect("drag-update", update)
    drag.connect("drag-end", end)
    handle.add_controller(drag)
    handle.set_cursor_from_name("grab")


# ── Glass ──────────────────────────────────────────────────────────────────────────────────
# A real blur needs the compositor: it is the only one that sees what is behind a window.
# Hyprland and SwayFX can blur layer surfaces on request; others (KDE, niri, river, labwc…)
# do not offer it to GTK apps. There, the desktop widget, which sits right on the wallpaper,
# blurs the wallpaper itself, which looks the same; the chat panel just gets more opaque.

def _quiet(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def request_native_blur():
    """Asks the compositor to blur behind our surfaces. Returns True if it will."""
    namespaces = ("archmates-widget", "archmates-chat")
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        option = _quiet("hyprctl", "getoption", "decoration:blur:enabled")
        if "false" in option or "int: 0" in option:
            return False  # blur turned off in your Hyprland settings
        for ns in namespaces:
            lua = (f'hl.layer_rule({{ name = "archmates-live-{ns}", match = {{ namespace = "^{ns}$" }}, '
                   f'blur = true, ignore_alpha = 0.05 }})')
            if _quiet("hyprctl", "eval", lua) == "ok":  # hyprland.lua
                continue
            # hyprland.conf: the 0.53+ rule syntax, then the older one.
            if _quiet("hyprctl", "keyword", "layerrule", f"blur on, match:namespace ^{ns}$") == "ok":
                _quiet("hyprctl", "keyword", "layerrule", f"ignore_alpha 0.05, match:namespace ^{ns}$")
                continue
            if _quiet("hyprctl", "keyword", "layerrule", f"blur,^{ns}$") == "ok":
                _quiet("hyprctl", "keyword", "layerrule", f"ignorealpha 0.05,^{ns}$")
                continue
            return False
        return True
    if os.environ.get("SWAYSOCK") and shutil.which("swaymsg"):
        # SwayFX only: plain sway has no blur, and rejects the command.
        return all(subprocess.run(["swaymsg", "layer_effects", ns, "blur enable"], capture_output=True).returncode == 0
                   for ns in namespaces)
    return False


def wallpaper_path(connector):
    """The picture your wallpaper tool shows on this screen (None if unknown)."""
    candidates = []
    if shutil.which("noctalia"):
        candidates.append(_quiet("noctalia", "msg", "wallpaper-get", connector or ""))
    for tool in ("awww", "swww"):
        if shutil.which(tool):
            for line in _quiet(tool, "query").splitlines():
                if (not connector or line.startswith(connector + ":")) and "image: " in line:
                    candidates.append(line.split("image: ", 1)[1].strip())
    if shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        for line in _quiet("hyprctl", "hyprpaper", "listactive").splitlines():
            name, _, path = line.partition(" = ")
            if path and (not connector or name.strip() in (connector, "")):
                candidates.append(path.strip())
    for cmdline in Path("/proc").glob("[0-9]*/cmdline"):
        try:
            args = cmdline.read_bytes().split(b"\0")
        except OSError:
            continue
        if args and os.path.basename(args[0].decode(errors="ignore")) == "swaybg":
            args = [a.decode(errors="ignore") for a in args]
            output = None
            for i, a in enumerate(args[:-1]):
                if a in ("-o", "--output"):
                    output = args[i + 1]
                if a in ("-i", "--image") and output in (None, "*", connector):
                    candidates.append(args[i + 1])
    for ini in (HOME / ".config/waypaper/config.ini",):
        try:
            for line in ini.read_text().splitlines():
                if line.startswith("wallpaper ="):
                    candidates.append(os.path.expanduser(line.split("=", 1)[1].strip()))
        except OSError:
            pass
    try:
        for line in (HOME / ".config/plasma-org.kde.plasma.desktop-appletsrc").read_text().splitlines():
            if line.startswith("Image=file://"):
                candidates.append(line.removeprefix("Image=file://"))
    except OSError:
        pass
    return next((c for c in candidates if c and os.path.isfile(c)), None)


class Frost:
    """The wallpaper of one screen, blurred once on the GPU (Gsk blur node), then drawn behind
    the widget card at the card's place on that screen."""

    RADIUS = 28

    def __init__(self):
        self.path = None
        self.texture = None
        self.size = None
        self.checked = 0.0

    def refresh(self, window, monitor):
        """Re-reads the wallpaper (at most every 20 s); True if it changed."""
        if monitor is None or time.time() - self.checked < 20:
            return False
        self.checked = time.time()
        path = wallpaper_path(monitor.get_connector())
        geo = monitor.get_geometry()
        size = (geo.width, geo.height)
        if path == self.path and size == self.size and self.texture is not None:
            return False
        self.path, self.size, self.texture = path, size, None
        renderer = window.get_renderer() if window.get_native() else None
        if not path or renderer is None:
            return True
        try:
            source = Gdk.Texture.new_from_filename(path)
        except GLib.Error:
            return True
        w, h = size
        # "Cover" fit, slightly larger than the screen so the blur has no faded edges.
        pad = self.RADIUS * 2
        scale = max((w + 2 * pad) / source.get_width(), (h + 2 * pad) / source.get_height())
        tw, th = source.get_width() * scale, source.get_height() * scale
        snap = Gtk.Snapshot()
        snap.push_blur(self.RADIUS)
        snap.append_texture(source, Graphene.Rect().init((w - tw) / 2, (h - th) / 2, tw, th))
        snap.pop()
        node = snap.to_node()
        if node is not None:
            self.texture = renderer.render_texture(node, Graphene.Rect().init(0, 0, w, h))
        return True

    def paint(self, snapshot, widget, x, y, tint):
        """Draws the frosted wallpaper inside `widget`'s rounded border, as if seen through it."""
        if self.texture is None:
            return False
        w, h = widget.get_width(), widget.get_height()
        rect = Graphene.Rect().init(1, 1, w - 2, h - 2)  # inside the 1 px border
        r = Graphene.Size().init(17, 17)
        snapshot.push_rounded_clip(Gsk.RoundedRect().init(rect, r, r, r, r))
        snapshot.append_texture(self.texture, Graphene.Rect().init(-x, -y, *self.size))
        snapshot.append_color(tint, rect)
        top = Gdk.RGBA()
        top.parse("rgba(255,255,255,0.07)")
        clear = Gdk.RGBA()
        clear.parse("rgba(255,255,255,0)")
        stops = [Gsk.ColorStop(), Gsk.ColorStop()]
        stops[0].offset, stops[0].color = 0.0, top
        stops[1].offset, stops[1].color = 0.45, clear
        snapshot.append_linear_gradient(rect, Graphene.Point().init(0, 0), Graphene.Point().init(0, h), stops)
        snapshot.pop()
        return True


class GlassCard(Gtk.Box):
    """The widget card. When the compositor cannot blur, it draws `Frost` under its content."""

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.frost = None
        self.where = None   # () -> (x, y) of the card on its screen
        self.tint = None

    def do_snapshot(self, snapshot):
        if self.frost is not None and self.where is not None and self.tint is not None:
            x, y = self.where()
            self.frost.paint(snapshot, self, x, y, self.tint)
        Gtk.Box.do_snapshot(self, snapshot)


NATIVE_BLUR = False


IMAGE_EXT = (".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp")


def image_preview(path, width=240, height=170):
    """A scaled picture for the chat (None if the file is not a readable image)."""
    if not path or not path.lower().endswith(IMAGE_EXT) or not os.path.exists(path):
        return None
    try:
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, width, height, True)
    except (GLib.Error, ValueError, ImportError):
        return None
    import warnings
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", DeprecationWarning)
        texture = Gdk.Texture.new_for_pixbuf(pix)
    pic = Gtk.Picture.new_for_paintable(texture)
    pic.set_size_request(pix.get_width(), pix.get_height())
    pic.set_can_shrink(False)
    pic.add_css_class("chat-image")
    return pic


